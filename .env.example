# Required for the model-generated Agent Graph and `npm run agent`.
LLM_API_KEY=

# Optional: any OpenAI-compatible endpoint and model.
BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional Solana devnet overrides. Defaults use the public Solana endpoints.
AGACY_RPC_URL=https://api.devnet.solana.com
AGACY_WS_URL=wss://api.devnet.solana.com

# Optional JSON byte array for a funded devnet payer.
# Leave empty to use the default Solana CLI keypair for proof scripts.
AGACY_PAYER_SECRET_KEY=

# Mainnet is disabled by default. These are only used by `npm run agent:mainnet`.
AGACY_CLUSTER=devnet
AGACY_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
AGACY_MAINNET_PAYER_SECRET_KEY=
# Set the exact phrase below only when deliberately enabling real-money execution:
# AGACY_MAINNET_CONFIRM=i-understand-this-spends-real-money
AGACY_MAINNET_CONFIRM=
AGACY_MAINNET_MAX_SPEND_SOL=
